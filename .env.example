# ===== termhub =====
# Copie para .env e ajuste. Lido pelo servidor (raiz do monorepo) e pelo docker compose.

NODE_ENV=development
PORT=3000
# Interface de escuta do servidor. Produção atrás do Cloudflare Tunnel: 127.0.0.1.
# Para acessar direto pelo IP na rede local: 0.0.0.0
HOST=127.0.0.1
# No docker compose (perfil prod): em qual IP do host publicar a porta (127.0.0.1 ou 0.0.0.0)
BIND_ADDR=127.0.0.1

# URL pública usada em redirects do OAuth e no cookie "secure".
# Dev: http://localhost:5173 (Vite) | LAN: http://192.168.x.x:3000 | Tunnel: https://termhub.seudominio.com
PUBLIC_URL=http://localhost:5173

# ----- Banco (Postgres) -----
# "docker compose up -d" sobe um Postgres local com estas credenciais na porta DB_PORT.
POSTGRES_USER=termhub
POSTGRES_PASSWORD=termhub
POSTGRES_DB=termhub
DB_PORT=5434
DATABASE_URL=postgresql://termhub:termhub@localhost:5434/termhub

# ----- Autenticação -----
# app        -> login por código no e-mail / senha / Google, com cookie de sessão
# cloudflare -> valida o JWT do Cloudflare Access (header Cf-Access-Jwt-Assertion)
# disabled   -> SEM autenticação (apenas dev local!)
# Pode combinar "app,cloudflare" para defesa em camadas.
AUTH_MODE=app
SESSION_TTL_DAYS=30
# true | false | auto (auto = true se PUBLIC_URL for https)
COOKIE_SECURE=auto
LOGIN_CODE_TTL_MINUTES=10

# ----- E-mail (código de login) -----
# Dev: Mailpit do docker compose (UI em http://localhost:8025). Sem SMTP_HOST nenhum e-mail é enviado
# (o login por código falha); só em desenvolvimento, EMAIL_DEV_CONSOLE=true imprime os e-mails no log.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=termhub <termhub@localhost>
EMAIL_DEV_CONSOLE=false
# Prod (ex.: Mailgun): SMTP_HOST=smtp.mailgun.org SMTP_PORT=587 SMTP_USER=postmaster@... SMTP_PASS=...

# Google OAuth (opcional). Redirect URI autorizado: <PUBLIC_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google: cria o usuário no primeiro login com uma conta desconhecida (role AUTH_DEFAULT_ROLE).
# Faz sentido quando o app está atrás do Cloudflare Access, que já filtra quem chega.
# AUTH_GOOGLE_SIGNUP=false
# AUTH_DEFAULT_ROLE=AUTHENTICATED

# Cloudflare Access (obrigatório se AUTH_MODE incluir "cloudflare")
# CF_TEAM_DOMAIN=https://seutime.cloudflareaccess.com
# CF_AUD=<Application Audience (AUD) Tag do app no Zero Trust>

# Cloudflare Access allowlist (opcional): convites em Configurações → Usuários liberam o e-mail na
# policy de "allow" do app no Zero Trust, e excluir o usuário remove. Token de API com o escopo
# Account · Access: Apps and Policies · Edit. Sem CF_ACCOUNT_ID/CF_API_TOKEN, convites só criam o
# usuário e enviam o e-mail.
# CF_ACCOUNT_ID=
# CF_API_TOKEN=
# CF_ACCESS_APP_DOMAIN=app.termhub.dev   (padrão: host de PUBLIC_URL)

# Monitor das tabs: URL onde os hooks instalados nas máquinas postam (precisa ser alcançável sem
# sessão de navegador). Em produção, o host da landing encaminha só esse caminho para o app,
# fora do Cloudflare Access. Padrão: <PUBLIC_URL>/api/hooks/events
# HOOKS_URL=https://termhub.dev/api/hooks/events

# Endpoint MCP público (terminal global). Aparece no comando "claude mcp add" quando um token de
# API é criado (Configurações → Tokens de API). Vazio = o comando não aparece.
# Também é obrigatório para o chat concierge: é por aqui que ele lê as máquinas. Precisa ser um host
# fora do Cloudflare Access (termhub.dev), não o host do app (app.termhub.dev).
# MCP_URL=https://termhub.dev/mcp

# Where public cities live (/city/@nickname): share links and link previews are built from it.
# Must be a host without Cloudflare Access. Default: the origin of HOOKS_URL, else PUBLIC_URL.
# PUBLIC_CITY_URL=https://termhub.dev/city

# Mobile app API (/api/m/v1, /ws/m/chat): the public base the phone calls and signs every proof's URL
# against — a host without Cloudflare Access (termhub.dev), never PUBLIC_URL. Unset = the prefix is off.
# MOBILE_PUBLIC_URL=https://termhub.dev
# Oldest app version (x.y.z) still served; an older X-Termhub-App gets 426 APP_TOO_OLD. Unset = any version.
# MOBILE_MIN_APP_VERSION=1.0.0
# Expo push access token (expo.dev → Access tokens), sent with every push; required only when the Expo
# project enforces enhanced push security. Unset = pushes go out unauthenticated.
# EXPO_PUSH_ACCESS_TOKEN=

# TypeToAccess (partner of termhub): creates each public city's short link, 77a.it/<nickname>.
# Empty = no short links: the long /city/@nickname link is used everywhere.
# TYPETOACCESS_API_KEY=

# Grupo do WhatsApp linkado no e-mail de alpha tester (aba Waitlist → Convidar)
# ALPHA_COMMUNITY_URL=https://77a.it/comunidadetermhub
# CF_ACCESS_POLICY_NAME=allowlist        (nome da policy cujo "include" lista os e-mails)

# ----- Terminais -----
# Cria a máquina "local" no primeiro boot. No Docker a "local" é o container — prefira false
# e cadastre o host como máquina SSH.
SEED_LOCAL_MACHINE=true
# Shell padrão dentro do tmux local (padrão: $SHELL)
# LOCAL_SHELL=/bin/zsh
# Caminho do tmux (útil quando roda como serviço com PATH mínimo)
# TMUX_PATH=/opt/homebrew/bin/tmux

TZ=America/Sao_Paulo

# ----- Ditado por voz nos terminais -----
# Serviço de transcrição (docker/whisper, faster-whisper em CPU). O docker compose sobe o
# serviço "whisper" e aponta o app para ele; rodando o server fora do Docker, aponte para a porta
# publicada ou deixe vazio para esconder o microfone.
# WHISPER_URL=http://localhost:8000
# Modelo: medium (padrão: melhor pt-BR, ~3x tempo real) | small (3x mais rápido, erra nomes).
# large-v3 e large-v3-turbo saíram piores em português (sem pontuação) e mais lentos.
# WHISPER_MODEL=medium
# Idioma esperado ("auto" detecta)
# WHISPER_LANGUAGE=pt

# Chat decision memory (docker/embed, fastembed on CPU): local text-embedding service used to
# suggest a past decision on a repeated "choice" question. The docker compose "embed" service
# points the app at it by default; empty EMBED_SECRET turns the service (and the suggestions) off.
# Generate the secret with: openssl rand -base64 32
# EMBED_URL=http://localhost:8000
# EMBED_SECRET=
# Cosine similarity a past decision needs to be suggested (0-1). The default is precision-first:
# near-verbatim repeats are suggested, paraphrases are not; lower it to trade precision for recall.
# DECISION_SUGGEST_THRESHOLD=0.98

# Concierge memory (docs/superpowers/specs/2026-09-26-concierge-memory-mcp-design.md): lets the
# concierge search a wider memory (cards, typed messages, gate decisions, specs/plans, notes) and
# answer a tab's open question on the person's behalf instead of typing — only ever with "Responder
# sozinho quando houver precedente" on and a person's own past decision to back it, and only after a
# visible, cancellable countdown.
# Seconds an automatic answer counts down on the card before it is sent (10-600).
# AUTO_ANSWER_DELAY_SECONDS=60
# Cosine similarity the cited decision's question needs against the new one for mode "auto" to be
# scheduled (0-1); below it (or with no embedder) the answer is only suggested.
# AUTO_ANSWER_MIN_SIMILARITY=0.80
# At most this many concierge wake turns per conversation per hour, for a tab question nobody
# answered; each is a run on the person's own Claude account. 0 disables every wake.
# AUTO_WAKE_MAX_PER_HOUR=12

# Chat concierge (docker/concierge): shared secret between the app and the container runner, and the
# host paths of the Claude accounts it may use. Generate the secret with: openssl rand -base64 32
# The chat itself does NOT need these any more: it runs on each user's own machine, through the agent
# installed there, and its only requirement is MCP_URL — with MCP_URL empty every message answers 503
# CONCIERGE_DISABLED. CONCIERGE_URL and CONCIERGE_SECRET reach only the container below, which no code
# path calls today, so setting them enables nothing and leaving them empty disables nothing.
CONCIERGE_SECRET=
CONCIERGE_URL=http://concierge:4100
# uid:gid the container runs as (defaults to 1000:1000): must own the config dirs below, or the CLI
# leaves them root-owned and the host user's own `claude` starts failing with EACCES.
# CONCIERGE_UID=1000
# CONCIERGE_GID=1000
CONCIERGE_PRIMARY_CONFIG_DIR=/home/pedrogoiania/.claude_pedrogoiania

# Criptografia dos segredos das integrações (obrigatório para usar Integrações). Gere com: openssl rand -base64 32
ENCRYPTION_KEY=

# ----- Analytics (landing + app) -----
# Firebase Analytics da landing (termhub.dev) e do app (app.termhub.dev), mesmo Web App do
# Firebase nos dois. As variáveis VITE_* entram no build das duas imagens (build args do
# docker compose), então mudar exige rebuild. Vazias = sem analytics.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# termhub.dev vhosts, rendered by deploy/blue-green.sh: the app upstream below is
# swapped for the active color's container. The landing is a static container
# that the deploy workflow recreates before the blue/green switch.

# Tab monitor ingestion: per-client budget (the client IP comes from Cloudflare; an empty key is not limited)
limit_req_zone $http_cf_connecting_ip zone=termhub_hooks:1m rate=20r/s;

# MCP endpoint (global terminal): per-client budget; the app also limits per token
limit_req_zone $http_cf_connecting_ip zone=termhub_mcp:1m rate=10r/s;

# Public city: per-client budget for an audience with no account (the client IP comes from Cloudflare)
limit_req_zone $http_cf_connecting_ip zone=termhub_public:1m rate=5r/s;
limit_conn_zone $http_cf_connecting_ip zone=termhub_public_conn:1m;

# Mobile API (spec 2026-09-24): per-client budgets; the app authenticates every call itself
limit_req_zone $http_cf_connecting_ip zone=termhub_mobile:1m rate=10r/s;
limit_req_zone $http_cf_connecting_ip zone=termhub_mobile_enrol:1m rate=2r/s;
limit_conn_zone $http_cf_connecting_ip zone=termhub_mobile_conn:1m;

# Landing page
server {
    listen 80;
    server_name termhub.dev www.termhub.dev;
    # resolver do Docker + variável: nginx re-resolve o IP quando o container é recriado.
    # Todo upstream deste arquivo tem que passar por variável: um `proxy_pass` com o host
    # literal cria um server group implícito chamado `host:porta`, e nginx procura o nome
    # nesses grupos ANTES de usar o resolver — um único literal para o mesmo `host:porta`
    # deixa a variável presa no IP resolvido na carga da config e torna o resolver inócuo.
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $upstream_app __APP_HOST__;
    set $upstream_landing termhub-landing;
    # Cloud waitlist form: same-origin POST forwarded to the app (public route, no Access on this host)
    location = /api/waitlist {
        limit_except POST { deny all; }
        proxy_pass http://$upstream_app:3000;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $http_cf_connecting_ip;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        client_max_body_size 64k;
    }
    # Tab monitor: the machines' hook scripts post here (public route, bearer token; no Access on this host)
    location = /api/hooks/events {
        limit_except POST { deny all; }
        limit_req zone=termhub_hooks burst=40 nodelay;
        limit_req_status 429;
        proxy_pass http://$upstream_app:3000;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $http_cf_connecting_ip;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        client_max_body_size 256k;
    }
    # Global terminal: MCP clients post here with a personal API token (public route; no Access on this host)
    location = /mcp {
        limit_except POST { deny all; }
        limit_req zone=termhub_mcp burst=20 nodelay;
        limit_req_status 429;
        proxy_pass http://$upstream_app:3000;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $http_cf_connecting_ip;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_buffering off;
        proxy_read_timeout 120s;
        client_max_body_size 256k;
    }
    # Mobile app (spec 2026-09-24): the phone signs every call with a device token + DPoP proof (public
    # routes; no Access on this host). The path is forwarded untouched: every proof signs the exact URL.
    # Enrolment requests and their status polls: the tightest budget, it is the one anonymous entry point
    location /api/m/v1/devices/requests {
        limit_req zone=termhub_mobile_enrol burst=5 nodelay;
        limit_req_status 429;
        proxy_pass http://$upstream_app:3000;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $http_cf_connecting_ip;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header CF-IPCountry      $http_cf_ipcountry;
        proxy_set_header CF-IPCity         $http_cf_ipcity;
        client_max_body_size 64k;
        proxy_read_timeout 30s;
    }
    # Session challenge and token renewal (the PIN proof): same budget as enrolment
    location /api/m/v1/session/ {
        limit_req zone=termhub_mobile_enrol burst=5 nodelay;
        limit_req_status 429;
        proxy_pass http://$upstream_app:3000;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $http_cf_connecting_ip;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header CF-IPCountry      $http_cf_ipcountry;
        proxy_set_header CF-IPCity         $http_cf_ipcity;
        client_max_body_size 64k;
        proxy_read_timeout 30s;
    }
    # Voice dictation: the recorded audio is streamed to the app unbuffered
    location = /api/m/v1/transcriptions {
        limit_except POST { deny all; }
        limit_req zone=termhub_mobile burst=20 nodelay;
        limit_req_status 429;
        proxy_pass http://$upstream_app:3000;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $http_cf_connecting_ip;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header CF-IPCountry      $http_cf_ipcountry;
        proxy_set_header CF-IPCity         $http_cf_ipcity;
        proxy_request_buffering off;
        client_max_body_size 32m;
        proxy_read_timeout 120s;
    }
    # The rest of the mobile API: chat, devices, notifications, push token
    location /api/m/ {
        limit_req zone=termhub_mobile burst=20 nodelay;
        limit_req_status 429;
        proxy_pass http://$upstream_app:3000;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $http_cf_connecting_ip;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header CF-IPCountry      $http_cf_ipcountry;
        proxy_set_header CF-IPCity         $http_cf_ipcity;
        client_max_body_size 64k;
        proxy_read_timeout 60s;
    }
    # The phone's chat stream (/ws/m/chat): a few sockets per client
    location /ws/m/ {
        limit_conn termhub_mobile_conn 4;
        proxy_pass http://$upstream_app:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        "upgrade";
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $http_cf_connecting_ip;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 3600s;
    }
    # The public city: the page, its snapshot and its live channel (public routes; no Access on this host)
    location /city/ {
        limit_except GET { deny all; }
        limit_req zone=termhub_public burst=10 nodelay;
        limit_req_status 429;
        proxy_pass http://__APP_HOST__:3000;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $http_cf_connecting_ip;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }
    # The city's build output: content-hashed files, fetched all at once on the first visit (Pixi's
    # renderer chunks and the pixel-art sheets are ~20 requests), so the page's rate limit above would
    # 429 one of them and the scene would fail to start. Nothing here reaches the database.
    location /city/assets/ {
        limit_except GET { deny all; }
        proxy_pass http://__APP_HOST__:3000;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $http_cf_connecting_ip;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }
    location /api/public/ {
        limit_except GET { deny all; }
        limit_req zone=termhub_public burst=10 nodelay;
        limit_req_status 429;
        proxy_pass http://__APP_HOST__:3000;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $http_cf_connecting_ip;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }
    location /ws/public/ {
        limit_conn termhub_public_conn 4;
        proxy_pass http://__APP_HOST__:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        "upgrade";
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $http_cf_connecting_ip;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 3600s;
    }
    location / {
        proxy_pass http://$upstream_landing:80;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $http_cf_connecting_ip;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }
}

# App
server {
    listen 80;
    server_name app.termhub.dev;
    # mesma regra do bloco acima: resolver do Docker + variável, nunca o host literal
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $upstream_app __APP_HOST__;
    location / {
        proxy_pass http://$upstream_app:3000;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $http_cf_connecting_ip;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        # WebSocket dos terminais
        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        "upgrade";
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        client_max_body_size 20m;
    }
}
